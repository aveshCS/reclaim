# Copy to backend/.env for local runs. Never commit real values.
NODE_ENV=development
PORT=3000
# Local: printed by `npm run db:local`. Production: the Neon connection string (sslmode=require).
DATABASE_URL=postgresql://reclaim:change-me@localhost:5433/reclaim
# At least 32 random characters. Production: set only in the Render dashboard.
JWT_SECRET=replace-with-a-long-random-secret
# The Google OAuth *Web* client id(s) the app requests ID tokens for, comma-separated.
GOOGLE_CLIENT_IDS=
# Browser origins allowed to call the API. Leave empty: the mobile app needs no CORS.
ALLOWED_ORIGINS=
# Swagger at /v1/docs. Defaults to on outside production.
DOCS_ENABLED=
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
