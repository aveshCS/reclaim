{
  "name": "reclaim-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RECLAIM API: Google sign-in, backup and restore. Local-first app; this only stores what the user backs up.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "google-auth-library": "11.3.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
